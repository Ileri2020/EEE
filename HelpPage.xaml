<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EEE.HelpPage"
             Title="Help &amp; Controls Guide"
             BackgroundColor="#0D1117">

    <ScrollView Padding="20">
        <VerticalStackLayout Spacing="20" MaximumWidthRequest="950" HorizontalOptions="Center">

            <!-- ── Top Header ─────────────────────────────────────────────── -->
            <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                <Button Grid.Column="0"
                        Text="← Back to Circuit"
                        Style="{StaticResource ToolBtn}"
                        Clicked="OnBackClicked"/>
                <Label Grid.Column="1"
                       Text="❓  Workspace Button Guide"
                       TextColor="#C9D1D9"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                <Button Grid.Column="2"
                        Text="⚙ Settings"
                        Style="{StaticResource AccentBtn}"
                        Clicked="OnSettingsClicked"/>
            </Grid>

            <!-- Overview Card -->
            <Border BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Label Text="Welcome to EESimulator" TextColor="#58A6FF" FontSize="15" FontAttributes="Bold"/>
                    <Label Text="Use the shared workspace sidebar buttons to select, wire, move, rotate, and frame circuit components."
                           TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Workspace button controls ─────────────────────────────── -->
            <Border BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="🎛" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="WORKSPACE BUTTON CONTROLS"
                               TextColor="#58A6FF"
                               FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="200,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <!-- Header -->
                        <Label Grid.Row="0" Grid.Column="0" Text="BUTTON / TOOL" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="EFFECT / DESCRIPTION" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="CONTROL" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Select" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Choose a component, connection, or pin in the viewport." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Wire" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="Choose a source pin, then a destination pin or junction point." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="2" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Pan" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="3" Grid.Column="1" Text="Drag in the viewport to move the workspace." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="3" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="4" Grid.Column="0" Text="Move" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="4" Grid.Column="1" Text="Select a component, choose Move, then drag in the viewport." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="4" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="5" Grid.Column="0" Text="Rotate" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="5" Grid.Column="1" Text="Rotate the selected component by 90 degrees." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="5" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="6" Grid.Column="0" Text="Zoom + / −" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="6" Grid.Column="1" Text="Adjust viewport magnification." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="6" Grid.Column="2" Text="Sidebar buttons" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="7" Grid.Column="0" Text="Fit to screen" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="7" Grid.Column="1" Text="Center and scale all components to fit the viewport." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="7" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── Other sidebar buttons ──────────────────────────────────── -->
            <Border BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="14">
                    <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                        <Label Text="⚙" FontSize="18" VerticalOptions="Center"/>
                        <Label Text="OTHER SIDEBAR BUTTONS"
                               TextColor="#56D364"
                               FontSize="14"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               VerticalOptions="Center"/>
                    </HorizontalStackLayout>

                    <Grid ColumnDefinitions="220,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                          RowSpacing="10" ColumnSpacing="12">
                        <!-- Header -->
                        <Label Grid.Row="0" Grid.Column="0" Text="BUTTON" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Grid.Column="1" Text="EFFECT / DESCRIPTION" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                        <Label Grid.Row="0" Grid.Column="2" Text="CONTROL" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>

                        <Label Grid.Row="1" Grid.Column="0" Text="Undo / Redo" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="1" Grid.Column="1" Text="Reverse or restore the last circuit edit." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="1" Grid.Column="2" Text="Sidebar buttons" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="2" Grid.Column="0" Text="Properties" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="2" Grid.Column="1" Text="Edit the selected component." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="2" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="3" Grid.Column="0" Text="Copy / Delete" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="3" Grid.Column="1" Text="Duplicate or remove the selected item." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="3" Grid.Column="2" Text="Sidebar buttons" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="4" Grid.Column="0" Text="Live measurements" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="4" Grid.Column="1" Text="Show or hide circuit measurements." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="4" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="5" Grid.Column="0" Text="Waveform" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="5" Grid.Column="1" Text="Plot signals from the selected component." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="5" Grid.Column="2" Text="Sidebar button" TextColor="#8B949E" FontSize="11"/>

                        <Label Grid.Row="6" Grid.Column="0" Text="Component palette" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                        <Label Grid.Row="6" Grid.Column="1" Text="Add components with the palette controls." TextColor="#C9D1D9" FontSize="12"/>
                        <Label Grid.Row="6" Grid.Column="2" Text="Sidebar buttons" TextColor="#8B949E" FontSize="11"/>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- ── 3. Pro Tips & Features ─────────────────────────────────── -->
            <Border BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="18">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="💡  PRO TIPS &amp; SHORTCUTS"
                           TextColor="#D2A8FF"
                           FontSize="14"
                           FontAttributes="Bold"
                           CharacterSpacing="0.5"/>

                    <Label Text="• Select the Wire tool button before choosing two endpoint pins."
                           TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                    <Label Text="• Use the sidebar buttons for component properties, rotation, copying, deletion, and viewport controls."
                           TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                    <Label Text="• Use component palette controls to add components to the circuit."
                           TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                    <Label Text="• Custom controls can be configured from the control sidebar."
                           TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                </VerticalStackLayout>
            </Border>

            <!-- Back Button -->
            <Button Text="← Back to Circuit Workspace"
                    Style="{StaticResource AccentBtn}"
                    HorizontalOptions="Center"
                    Padding="24,10"
                    Margin="0,10,0,20"
                    Clicked="OnBackClicked"/>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
