<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EEE.ViewModels"
             xmlns:models="clr-namespace:EEE.Services"
             x:Class="EEE.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="Settings"
             BackgroundColor="#0D1117"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>
        <converters:InvertedBoolConverter x:Key="InvertedBoolConverter" xmlns:converters="clr-namespace:EEE.Converters"/>

        <!-- Tokens -->
        <Color x:Key="BgPrimary">#0D1117</Color>
        <Color x:Key="BgSurface">#161B22</Color>
        <Color x:Key="BgPanel">#1C2128</Color>
        <Color x:Key="BorderColor">#30363D</Color>
        <Color x:Key="AccentBlue">#58A6FF</Color>
        <Color x:Key="AccentGreen">#56D364</Color>
        <Color x:Key="AccentRed">#F78166</Color>
        <Color x:Key="AccentPurple">#D2A8FF</Color>
        <Color x:Key="TextPrimary">#C9D1D9</Color>
        <Color x:Key="TextMuted">#8B949E</Color>

        <Style x:Key="StandardBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#21262D"/>
            <Setter Property="TextColor" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#30363D"/>
        </Style>

        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#238636"/>
            <Setter Property="TextColor" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="0"/>
        </Style>

        <Style x:Key="DangerBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#21262D"/>
            <Setter Property="TextColor" Value="#F78166"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#F78166"/>
        </Style>

        <!-- Tab button: inactive -->
        <Style x:Key="TabBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#21262D"/>
            <Setter Property="TextColor" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#30363D"/>
        </Style>

        <!-- Tab button: active -->
        <Style x:Key="TabBtnActive" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#0D2137"/>
            <Setter Property="TextColor" Value="#58A6FF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontAttributes" Value="Bold"/>
            <Setter Property="Padding" Value="16,9"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#58A6FF"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOP HEADER BAR  (no StatusMessage here — §4.D)                  -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="#161B22"
              HeightRequest="56"
              Padding="16,0"
              ColumnDefinitions="Auto,*,Auto">

            <HorizontalStackLayout Grid.Column="0" Spacing="12" VerticalOptions="Center">
                <Button Text="← Back"
                        Style="{StaticResource StandardBtn}"
                        Command="{Binding GoBackCommand}"/>
                <Label Text="⚙ Application &amp; Controls Settings"
                       TextColor="#E6EDF3"
                       FontSize="16"
                       FontAttributes="Bold"
                       VerticalOptions="Center"/>
            </HorizontalStackLayout>

            <!-- Right-side: only Reset (confirmed by dialog — §4.C) -->
            <Button Grid.Column="2"
                    Text="↺ Reset to Defaults"
                    Style="{StaticResource StandardBtn}"
                    Command="{Binding ResetToDefaultsCommand}"/>

            <BoxView Grid.Row="0" Grid.ColumnSpan="3"
                     HeightRequest="1"
                     BackgroundColor="#30363D"
                     VerticalOptions="End"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TAB BAR (Controls | Viewport | Workspace) — §4.A               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <HorizontalStackLayout Grid.Row="1"
                               Padding="16,8"
                               Spacing="8"
                               BackgroundColor="#161B22">

            <!-- Controls tab -->
            <Button Text="🎛 Controls"
                    Style="{StaticResource TabBtn}"
                    Command="{Binding SwitchTabCommand}"
                    CommandParameter="Controls">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTabControls}" Value="True">
                        <Setter Property="Style" Value="{StaticResource TabBtnActive}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Viewport tab -->
            <Button Text="🖥 Viewport"
                    Style="{StaticResource TabBtn}"
                    Command="{Binding SwitchTabCommand}"
                    CommandParameter="Viewport">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTabViewport}" Value="True">
                        <Setter Property="Style" Value="{StaticResource TabBtnActive}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <!-- Workspace tab -->
            <Button Text="🗂 Workspace"
                    Style="{StaticResource TabBtn}"
                    Command="{Binding SwitchTabCommand}"
                    CommandParameter="Workspace">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsTabWorkspace}" Value="True">
                        <Setter Property="Style" Value="{StaticResource TabBtnActive}"/>
                    </DataTrigger>
                </Button.Triggers>
            </Button>

        </HorizontalStackLayout>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TAB CONTENT                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <ScrollView Grid.Row="2" Padding="20">
            <VerticalStackLayout Spacing="24" MaximumWidthRequest="960" HorizontalOptions="Center">

                <!-- ─────────────────────────────────────────────────────────── -->
                <!-- TAB: CONTROLS — Control Sidebar Button Manager               -->
                <!-- ─────────────────────────────────────────────────────────── -->
                <Border IsVisible="{Binding IsTabControls}"
                        BackgroundColor="#161B22"
                        Stroke="#30363D"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <!-- Header -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                            <Label Grid.Column="0" Text="🎛" FontSize="20" TextColor="#58A6FF" VerticalOptions="Center"/>
                            <VerticalStackLayout Grid.Column="1">
                                <Label Text="CONTROL SIDEBAR BUTTONS MANAGER"
                                       TextColor="#E6EDF3"
                                       FontSize="15"
                                       FontAttributes="Bold"/>
                                <Label Text="Create quick-action buttons (max 3-letter label) that appear in the Control Sidebar."
                                       TextColor="#8B949E"
                                       FontSize="12"/>
                            </VerticalStackLayout>
                            <!-- Active button count badge -->
                            <Border Grid.Column="2"
                                    BackgroundColor="#0D2137"
                                    Stroke="#58A6FF"
                                    StrokeThickness="1"
                                    Padding="10,4"
                                    VerticalOptions="Center">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12"/>
                                </Border.StrokeShape>
                                <Label Text="{Binding CustomButtons.Count, StringFormat='{0} buttons active'}"
                                       TextColor="#58A6FF"
                                       FontSize="11"
                                       FontAttributes="Bold"/>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#21262D"/>

                        <!-- Button Creator Form -->
                        <Border BackgroundColor="#0D1117"
                                Stroke="#30363D"
                                StrokeThickness="1"
                                Padding="14">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="8"/>
                            </Border.StrokeShape>

                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" RowSpacing="8">
                                <!-- Label input with char count (§3.E) -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="0" Spacing="4" WidthRequest="130">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0" Text="BUTTON LABEL" TextColor="#8B949E" FontSize="10" FontAttributes="Bold"/>
                                        <!-- Live char count: (N/3) -->
                                        <Label Grid.Column="1"
                                               Text="{Binding LabelCharCount}"
                                               TextColor="#58A6FF"
                                               FontSize="10"/>
                                    </Grid>
                                    <Entry Text="{Binding NewButtonLabel}"
                                           Placeholder="SIM"
                                           MaxLength="3"
                                           BackgroundColor="#161B22"
                                           TextColor="#58A6FF"
                                           FontAttributes="Bold"
                                           FontSize="16"/>
                                </VerticalStackLayout>

                                <!-- Action picker -->
                                <VerticalStackLayout Grid.Row="0" Grid.Column="1" Spacing="4">
                                    <Label Text="LINKED CIRCUIT ACTION" TextColor="#8B949E" FontSize="10" FontAttributes="Bold"/>
                                    <Picker ItemsSource="{Binding AvailableActions}"
                                            SelectedItem="{Binding SelectedAction}"
                                            BackgroundColor="#161B22"
                                            TextColor="#C9D1D9"
                                            FontSize="12"/>
                                </VerticalStackLayout>

                                <Button Grid.Row="0" Grid.Column="2"
                                        Text="➕ Add"
                                        Style="{StaticResource AccentBtn}"
                                        VerticalOptions="End"
                                        Command="{Binding CreateControlButtonCommand}"/>

                                <Label Grid.Row="1" Grid.ColumnSpan="3"
                                       Text="Actions apply immediately. Changes persist across app restarts."
                                       TextColor="#8B949E"
                                       FontSize="11"/>
                            </Grid>
                        </Border>

                        <!-- Active Buttons Table with Description column (§4.E) -->
                        <Label Text="ACTIVE CONTROL SIDEBAR BUTTONS"
                               TextColor="#8B949E"
                               FontSize="11"
                               FontAttributes="Bold"
                               CharacterSpacing="1"
                               Margin="0,6,0,0"/>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding CustomButtons}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:CustomControlButton">
                                    <Border BackgroundColor="#1C2128"
                                            Stroke="#30363D"
                                            StrokeThickness="1"
                                            Padding="12,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="6"/>
                                        </Border.StrokeShape>

                                        <Grid ColumnDefinitions="60,*,180,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                            <!-- 3-letter badge -->
                                            <Border Grid.Column="0"
                                                    BackgroundColor="#21262D"
                                                    Stroke="#58A6FF"
                                                    StrokeThickness="1"
                                                    Padding="8,4"
                                                    HorizontalOptions="Center"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="4"/>
                                                </Border.StrokeShape>
                                                <Label Text="{Binding Label}"
                                                       TextColor="#58A6FF"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       HorizontalOptions="Center"/>
                                            </Border>

                                            <!-- Action Picker -->
                                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                                                <Label Text="Connected Action:" TextColor="#8B949E" FontSize="10"/>
                                                <Picker ItemsSource="{Binding AvailableActions}"
                                                        SelectedItem="{Binding ActionName}"
                                                        BackgroundColor="#0D1117"
                                                        TextColor="#C9D1D9"
                                                        FontSize="12"
                                                        HeightRequest="36"/>
                                            </VerticalStackLayout>

                                            <!-- User Description Entry (§4.E) -->
                                            <VerticalStackLayout Grid.Column="2" VerticalOptions="Center" Spacing="2">
                                                <Label Text="Description (optional):" TextColor="#8B949E" FontSize="10"/>
                                                <Entry Text="{Binding UserDescription}"
                                                       Placeholder="What this button does..."
                                                       BackgroundColor="#0D1117"
                                                       TextColor="#C9D1D9"
                                                       FontSize="11"
                                                       HeightRequest="36"/>
                                            </VerticalStackLayout>

                                            <!-- Category badge -->
                                            <Label Grid.Column="3"
                                                   Text="{Binding Category}"
                                                   TextColor="#56D364"
                                                   FontSize="11"
                                                   VerticalOptions="Center"/>

                                            <!-- Delete button -->
                                            <Button Grid.Column="4"
                                                    Text="✕"
                                                    Style="{StaticResource DangerBtn}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type vm:SettingsViewModel}}, Path=DeleteControlButtonCommand}"
                                                    CommandParameter="{Binding .}"
                                                    VerticalOptions="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- ─────────────────────────────────────────────────────────── -->
                <!-- TAB: VIEWPORT SETTINGS                                       -->
                <!-- ─────────────────────────────────────────────────────────── -->
                <Border IsVisible="{Binding IsTabViewport}"
                        BackgroundColor="#161B22"
                        Stroke="#30363D"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <Label Text="🖥 VIEWPORT &amp; CANVAS DISPLAY"
                               TextColor="#E6EDF3"
                               FontSize="15"
                               FontAttributes="Bold"/>
                        <Label Text="Changes apply immediately and are saved automatically."
                               TextColor="#8B949E"
                               FontSize="12"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="12" ColumnSpacing="20">
                            <!-- Show Grid -->
                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Show Schematic Grid" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding ShowGrid}"/>
                            </Grid>

                            <!-- Show Origin Cross -->
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Show Origin Axis Cross" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding ShowOriginCross}"/>
                            </Grid>

                            <!-- Show Live Probes -->
                            <Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Display Live Component Probes" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding ShowLiveProbes}"/>
                            </Grid>

                            <!-- Show Waveform Badges -->
                            <Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Show Waveform Status Badges" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding ShowWaveformBadges}"/>
                            </Grid>

                            <!-- Canvas Theme Picker -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="0" Spacing="4">
                                <Label Text="CANVAS BACKGROUND THEME" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                                <Picker ItemsSource="{Binding CanvasThemes}"
                                        SelectedItem="{Binding SelectedCanvasTheme}"
                                        BackgroundColor="#0D1117"
                                        TextColor="#C9D1D9"/>
                            </VerticalStackLayout>

                            <!-- Grid Size Slider -->
                            <VerticalStackLayout Grid.Row="2" Grid.Column="1" Spacing="4">
                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Grid.Column="0" Text="GRID CELL SIZE" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                                    <Label Grid.Column="1" Text="{Binding GridSize, StringFormat='{0:F0} px'}" TextColor="#58A6FF" FontSize="11"/>
                                </Grid>
                                <Slider Minimum="10" Maximum="50" Value="{Binding GridSize}"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ─────────────────────────────────────────────────────────── -->
                <!-- TAB: WORKSPACE SETTINGS                                      -->
                <!-- ─────────────────────────────────────────────────────────── -->
                <Border IsVisible="{Binding IsTabWorkspace}"
                        BackgroundColor="#161B22"
                        Stroke="#30363D"
                        StrokeThickness="1"
                        Padding="20">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="10"/>
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="16">
                        <Label Text="🗂 WORKSPACE &amp; WORKFLOW"
                               TextColor="#E6EDF3"
                               FontSize="15"
                               FontAttributes="Bold"/>
                        <Label Text="Changes apply immediately and are saved automatically."
                               TextColor="#8B949E"
                               FontSize="12"/>

                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="12" ColumnSpacing="20">
                            <!-- Mobile Pan Mode On Startup -->
                            <Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Default to Pan Mode on Mobile" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding MobilePanModeOnStartup}"/>
                            </Grid>

                            <!-- Auto Run Simulation -->
                            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <Label Grid.Column="0" Text="Auto-Run Simulation on Edit" TextColor="#C9D1D9" FontSize="13" VerticalOptions="Center"/>
                                <Switch Grid.Column="1" IsToggled="{Binding AutoRunSimulation}"/>
                            </Grid>

                            <!-- Default Palette Category -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="0" Spacing="4">
                                <Label Text="DEFAULT PALETTE CATEGORY" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                                <Picker ItemsSource="{Binding AvailableCategories}"
                                        SelectedItem="{Binding DefaultCategory}"
                                        BackgroundColor="#0D1117"
                                        TextColor="#C9D1D9"/>
                            </VerticalStackLayout>

                            <!-- Mobile Toolbar Position (note: dock switching is pending implementation) -->
                            <VerticalStackLayout Grid.Row="1" Grid.Column="1" Spacing="4">
                                <Label Text="MOBILE TOOLBAR DOCK" TextColor="#8B949E" FontSize="11" FontAttributes="Bold"/>
                                <Picker ItemsSource="{Binding ToolbarPositions}"
                                        SelectedItem="{Binding MobileToolbarPosition}"
                                        BackgroundColor="#0D1117"
                                        TextColor="#C9D1D9"/>
                                <Label Text="Note: Bottom Bar and Floating modes are planned for a future update."
                                       TextColor="#484F58"
                                       FontSize="10"/>
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- BOTTOM STATUS / TOAST BAR (single StatusMessage location §4.D) -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="3"
              BackgroundColor="#161B22"
              HeightRequest="36"
              Padding="16,0"
              ColumnDefinitions="*,Auto">

            <BoxView Grid.ColumnSpan="2" HeightRequest="1" BackgroundColor="#30363D" VerticalOptions="Start"/>

            <!-- Toast message (auto-dismisses — only visible when IsToastVisible) -->
            <Label Grid.Column="0"
                   Text="{Binding StatusMessage}"
                   TextColor="#56D364"
                   FontSize="11"
                   IsVisible="{Binding IsToastVisible}"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="EESimulator Settings v2.1"
                   TextColor="#484F58"
                   FontSize="11"
                   VerticalOptions="Center"/>
        </Grid>

    </Grid>
</ContentPage>