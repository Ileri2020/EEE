              VerticalOptions="Fill">

            <Border MaximumWidthRequest="520"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1">
