<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EEE.ViewModels"
             xmlns:models="clr-namespace:EEE.Services"
             xmlns:core="clr-namespace:EESimulator.Core.Models"
             xmlns:views="clr-namespace:EESimulator.App.Views"
             xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspacePage"
             x:DataType="vm:EEWorkspaceViewModel"
             Title="EE Engine"
             BackgroundColor="#0D1117"
             Shell.NavBarIsVisible="False"
             x:Name="RootPage">

    <ContentPage.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspaceComponents/WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOP MENUBAR                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
                <parts:WorkspaceMenuBar Grid.Row="0" />

        <parts:WorkspaceFileMenu Grid.RowSpan="3" ZIndex="20" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MAIN WORKSPACE                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceMainLayout x:Name="MainWorkspace" Grid.Row="1" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceStatusBar Grid.Row="2" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- COMPONENT EDIT DIALOG MODAL OVERLAY                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceEditDialog Grid.RowSpan="3" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HELP MODAL OVERLAY                                               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceHelpDialog Grid.RowSpan="3" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SIMULATION SETUP MODAL OVERLAY                                    -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceSimulationSettingsDialog Grid.RowSpan="3" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SPICE NETLIST INSPECTOR MODAL                                     -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceNetlistDialog Grid.RowSpan="3" />

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- SAVE & SAVE AS PROJECT MODAL DIALOG                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <parts:WorkspaceSaveDialog Grid.RowSpan="3" />

        <!-- Latched/while-true simulation event chat surface. -->
        <parts:WorkspaceSimulationEventChat ZIndex="240" />

        <!-- UI-only event dialog; it is not connected to any circuit component. -->
        <parts:WorkspaceSimulationEventDialog ZIndex="250" />

        <!-- Save the selected connected circuit as a reusable component. -->
        <parts:WorkspaceCreateCircuitComponentDialog ZIndex="200" />

    </Grid>
</ContentPage>
