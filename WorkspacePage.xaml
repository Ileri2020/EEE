                                            <Entry Text="{Binding EditThresholdVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Transconductance (Kp)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditTransconductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Width (W, m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditChannelWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Length (L, m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditChannelLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- JFET Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsJfetComponent}">
                                    <Label Text="JFET SHICHMAN-HODGES MODEL" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Pinch-off V (Vto, V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditThresholdVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Transconductance (Beta, A/V²)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditTransconductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Channel Mod (Lambda, 1/V)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditLambda}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- OpAmp Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsOpAmpComponent}">
                                    <Label Text="OP-AMP FREQUENCY &amp; RAILS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="GBW (Hz)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditGainBandwidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Slew Rate (V/μs)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSlewRate}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Vcc+ Rail (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSupplyPositive}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Vee- Rail (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSupplyNegative}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Parasitics, Temperature, and Initial Conditions -->
                                <Label Text="PARASITICS &amp; TEMPERATURE MODELING" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Temperature (°C)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditTemperature}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Initial Condition (IC)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditInitialCondition}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="TempCo TC1" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditTempCoeff1}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="ESR / Rdc (Ω)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditEquivalentSeriesResistance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- ─── TAB 4: NODES & TERMINALS ────────────────── -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditTabPins}">
                                <Label Text="COMPONENT TERMINAL PINS"
                                       TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditPins}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinEditItem">
                                            <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Id, StringFormat='Pin: {0}'}"
                                                       TextColor="#8B949E"
                                                       FontSize="11"
                                                       VerticalOptions="Center"/>
