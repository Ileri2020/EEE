                                                       Text="{Binding Name}"
                                                       BackgroundColor="#0D1117"
                                                       TextColor="#C9D1D9"
                                                       FontSize="12"
                                                       HeightRequest="36"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Dialog Actions Footer -->
                    <Grid Grid.Row="3" BackgroundColor="#1C2128" Padding="14,10" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Grid.Column="0"
                                Text="Delete"
                                Style="{StaticResource ToolBtn}"
                                TextColor="#F78166"
                                Command="{Binding DeleteEditingComponentCommand}"/>

                        <Button Grid.Column="2"
                                Text="Cancel"
                                Style="{StaticResource ToolBtn}"
                                Command="{Binding CloseEditDialogCommand}"
                                Margin="0,0,6,0"/>

                        <Button Grid.Column="3"
                                Text="Apply"
                                Style="{StaticResource AccentBtn}"
                                Command="{Binding ApplyEditDialogCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- HELP MODAL OVERLAY                                               -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
