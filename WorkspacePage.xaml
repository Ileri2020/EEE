<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:EEE.ViewModels"
             xmlns:models="clr-namespace:EEE.Services"
             xmlns:views="clr-namespace:EESimulator.App.Views"
             x:Class="EEE.WorkspacePage"
             x:DataType="vm:EEWorkspaceViewModel"
             Title="EESimulator"
             BackgroundColor="#0D1117"
             Shell.NavBarIsVisible="False"
             x:Name="RootPage">

    <ContentPage.Resources>
        <!-- Color tokens -->
        <Color x:Key="BgPrimary">#0D1117</Color>
        <Color x:Key="BgSurface">#161B22</Color>
        <Color x:Key="BgPanel">#1C2128</Color>
        <Color x:Key="BgHover">#21262D</Color>
        <Color x:Key="BorderColor">#30363D</Color>
        <Color x:Key="AccentBlue">#58A6FF</Color>
        <Color x:Key="AccentGreen">#56D364</Color>
        <Color x:Key="AccentRed">#F78166</Color>
        <Color x:Key="AccentPurple">#D2A8FF</Color>
        <Color x:Key="TextPrimary">#C9D1D9</Color>
        <Color x:Key="TextMuted">#8B949E</Color>
        <Color x:Key="TextDim">#484F58</Color>

        <!-- Toolbar button style -->
        <Style x:Key="ToolBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="Transparent"/>
            <Setter Property="TextColor" Value="#8B949E"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontFamily" Value="OpenSansRegular"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="0"/>
            <Setter Property="VisualStateManager.VisualStateGroups">
                <VisualStateGroupList>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#21262D"/>
                                <Setter Property="TextColor" Value="#C9D1D9"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="#30363D"/>
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateGroupList>
            </Setter>
        </Style>

        <!-- Icon toolbar button -->
        <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource ToolBtn}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="MinimumWidthRequest" Value="36"/>
        </Style>

        <!-- Accent button -->
        <Style x:Key="AccentBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#238636"/>
            <Setter Property="TextColor" Value="#FFFFFF"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderWidth" Value="0"/>
        </Style>

        <!-- Palette item button -->
        <Style x:Key="PaletteBtn" TargetType="Button">
            <Setter Property="BackgroundColor" Value="#1C2128"/>
            <Setter Property="TextColor" Value="#C9D1D9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="6,8"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderWidth" Value="1"/>
            <Setter Property="BorderColor" Value="#30363D"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- TOP MENUBAR                                                      -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="0"
              BackgroundColor="#161B22"
              HeightRequest="44"
              ColumnDefinitions="Auto,*,Auto">

            <!-- Left: App branding & File Nav -->
            <HorizontalStackLayout Grid.Column="0" Spacing="4" Padding="8,0" VerticalOptions="Center">
                <!-- Logo -->
                <Label Text="⚡"
                       FontSize="18"
                       TextColor="#58A6FF"
                       VerticalOptions="Center"
                       Margin="0,0,2,0"/>
                <Label Text="EESimulator"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C9D1D9"
                       VerticalOptions="Center"
                       Margin="0,0,4,0"/>

                <BoxView WidthRequest="1" HeightRequest="20" Color="#30363D" VerticalOptions="Center" Margin="4,0"/>

                <!-- Save button (Desktop: 💾 Save, Mobile: 💾) -->
                <Button Text="{OnIdiom Phone='💾', Default='💾 Save'}"
                        Style="{StaticResource ToolBtn}"
                        TextColor="#56D364"
                        FontSize="12"
                        Padding="8,5"
                        Command="{Binding SaveProjectCommand}"
                        ToolTipProperties.Text="Save Project (Ctrl+S)"/>

                <!-- Save As button (Desktop: ⤓ Save As, Mobile: 💾+) -->
                <Button Text="{OnIdiom Phone='💾+', Default='⤓ Save As'}"
                        Style="{StaticResource ToolBtn}"
                        TextColor="#79C0FF"
                        FontSize="12"
                        Padding="8,5"
                        Command="{Binding SaveProjectAsCommand}"
                        ToolTipProperties.Text="Save Project As (.eee, .kicad_sch, .cir, .eesim, .py)"/>
            </HorizontalStackLayout>

            <!-- Center: Project name -->
            <Label Grid.Column="1"
                   Text="{Binding ProjectName}"
                   TextColor="#8B949E"
                   FontSize="12"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- Right: icon-only toolbar buttons -->
            <HorizontalStackLayout Grid.Column="2" Spacing="2" Padding="6,0" VerticalOptions="Center">
                    <!-- Rotate selected -->
                    <Button Text="⟳" Style="{StaticResource IconBtn}"

                            TextColor="#D2A8FF"
                            Command="{Binding RotateSelectedComponentCommand}"
                            ToolTipProperties.Text="Rotate Selected Component 90°"/>
                    <BoxView WidthRequest="1" HeightRequest="24" Color="#30363D" VerticalOptions="Center" Margin="2,0"/>
                    <!-- Script / Schematic toggle ('SCR' label — §2.E; &lt;/&gt; entity breaks MAUI source gen) -->
                    <Button Text="SCR" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleViewportCommand}"
                            ToolTipProperties.Text="Toggle Script / Schematic View"/>
                    <!-- Waveform -->
                    <Button Text="📈" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleWaveformDrawerCommand}"
                            ToolTipProperties.Text="Waveform / Oscilloscope"/>
                    <!-- Sim setup -->
                    <Button Text="⚡" Style="{StaticResource IconBtn}"
                            TextColor="#E3B341"
                            Command="{Binding OpenSimSettingsCommand}"
                            ToolTipProperties.Text="Simulation Setup"/>
                    <!-- Examples Library -->
                    <Button Text="📚" Style="{StaticResource IconBtn}"
                            TextColor="#58A6FF"
                            Command="{Binding OpenExamplesPageCommand}"
                            ToolTipProperties.Text="Circuit Examples Library (.eee)"/>
                    <!-- Settings -->
                    <Button Text="⚙" Style="{StaticResource IconBtn}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTipProperties.Text="Settings"/>
                    <!-- Help -->
                    <Button Text="❓" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleHelpCommand}"
                            ToolTipProperties.Text="Help"/>

            </HorizontalStackLayout>


            <!-- Bottom border line -->
            <BoxView Grid.Row="0" Grid.ColumnSpan="3"
                     HeightRequest="1"
                     BackgroundColor="#30363D"
                     VerticalOptions="End"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- MAIN WORKSPACE                                                   -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1"
              ColumnDefinitions="{OnIdiom Phone='52,*', Default='52,Auto,*,Auto'}">

            <!-- ─── Left toolbar ─────────────────────────────────────────── -->
            <Grid Grid.Column="0"
                  BackgroundColor="#161B22"
                  RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Never">
                    <VerticalStackLayout Spacing="4" Padding="6,8">
                        <!-- Sidebar toggles stacked vertically together -->
                        <Button Text="🧩"
                                Style="{StaticResource IconBtn}"
                                TextColor="#58A6FF"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTipProperties.Text="Toggle Component Sidebar"/>
                        <Button Text="🎛"
                                Style="{StaticResource IconBtn}"
                                TextColor="#58A6FF"
                                Command="{Binding ToggleControlSidebarCommand}"
                                ToolTipProperties.Text="Toggle Control Sidebar"/>
                        <Button Text="📄"
                                Style="{StaticResource IconBtn}"
                                TextColor="#E3B341"
                                Command="{Binding ToggleDescriptionSidebarCommand}"
                                ToolTipProperties.Text="Toggle Description &amp; Properties Sidebar"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Undo / Redo -->
                        <Button Text="↩" Style="{StaticResource IconBtn}"
                                Command="{Binding UndoCommand}"
                                IsEnabled="{Binding CanUndo}"
                                ToolTipProperties.Text="Undo"/>
                        <Button Text="↪" Style="{StaticResource IconBtn}"
                                Command="{Binding RedoCommand}"
                                IsEnabled="{Binding CanRedo}"
                                ToolTipProperties.Text="Redo"/>

                        <!-- Rotate / Copy / Delete selected component -->
                        <Button Text="⟳" Style="{StaticResource IconBtn}"
                                TextColor="#D2A8FF"
                                Command="{Binding RotateSelectedComponentCommand}"
                                ToolTipProperties.Text="Rotate Selected 90°"/>
                        <Button Text="📋" Style="{StaticResource IconBtn}"
                                TextColor="#79C0FF"
                                Command="{Binding CopySelectedComponentCommand}"
                                IsEnabled="{Binding HasSelectedComponent}"
                                ToolTipProperties.Text="Copy Selected Component"/>
                        <Button Text="🗑" Style="{StaticResource IconBtn}"
                                TextColor="#F85149"
                                Command="{Binding DeleteSelectedComponentCommand}"
                                IsEnabled="{Binding HasSelectedComponent}"
                                ToolTipProperties.Text="Delete Selected Component"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Selection / drawing tools -->
                        <Button Text="↖" Style="{StaticResource IconBtn}" CommandParameter="Select"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Select"/>
                        <Button Text="✏" Style="{StaticResource IconBtn}" CommandParameter="Wire"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Wire (long-press pin)"/>
                        <Button Text="✂" Style="{StaticResource IconBtn}" CommandParameter="Cut"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Cut wire"/>
                        <Button Text="⊕" Style="{StaticResource IconBtn}" CommandParameter="Label"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Net label"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Zoom tools -->
                        <Button Text="🔍" Style="{StaticResource IconBtn}" CommandParameter="ZoomIn"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Zoom in"/>
                        <Button Text="⊖" Style="{StaticResource IconBtn}" CommandParameter="ZoomOut"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Zoom out"/>
                        <Button Text="⊡" Style="{StaticResource IconBtn}" CommandParameter="FitAll"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Fit all"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Mobile: Pan / Select mode toggle buttons -->
                        <Button Text="✋"
                                x:Name="BtnMobilePan"
                                Style="{StaticResource IconBtn}"
                                Command="{Binding SetMobilePanModeCommand}"
                                ToolTipProperties.Text="Pan mode"/>
                        <Button Text="↖"
                                x:Name="BtnMobileSelect"
                                Style="{StaticResource IconBtn}"
                                Command="{Binding SetMobileSelectModeCommand}"
                                ToolTipProperties.Text="Select mode"/>
                        <!-- Help button is in the top-right toolbar; removed here to avoid duplication (§2.D) -->
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Right border -->
                <BoxView Grid.Row="0" Grid.RowSpan="2"
                         WidthRequest="1" BackgroundColor="#30363D"
                         HorizontalOptions="End"/>
            </Grid>

            <!-- ─── Column 1: Control Sidebar (Custom 3-letter action buttons) ───────── -->
            <Border Grid.Column="{OnIdiom Phone=1, Default=1}"
                    ZIndex="25"
                    HorizontalOptions="Start"
                    WidthRequest="220"
                    IsVisible="{Binding IsControlSidebarVisible}"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Sidebar Header -->
                    <Grid Grid.Row="0" BackgroundColor="#0D1117" Padding="12,10" ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="🎛" FontSize="14" TextColor="#58A6FF" VerticalOptions="Center"/>
                            <Label Text="CONTROLS"
                                   TextColor="#E6EDF3"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   CharacterSpacing="1"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource IconBtn}"
                                FontSize="11"
                                Padding="4"
                                Command="{Binding ToggleControlSidebarCommand}"
                                ToolTipProperties.Text="Close control sidebar"/>
                    </Grid>

                    <!-- Buttons list with 3-letter label badge and connected action dropdown -->
                    <ScrollView Grid.Row="1" Padding="8,6">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="CUSTOM CONTROL BUTTONS"
                                   TextColor="#8B949E"
                                   FontSize="10"
                                   FontAttributes="Bold"
                                   CharacterSpacing="1"
                                   Margin="4,2,0,2"/>

                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CustomControlButtons}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:CustomControlButton">
                                        <Border BackgroundColor="#1C2128"
                                                Stroke="#30363D"
                                                StrokeThickness="1"
                                                Padding="8,6">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="6"/>
                                            </Border.StrokeShape>

                                            <Grid RowDefinitions="Auto,Auto" RowSpacing="4">
                                                <!-- Row 0: 3-letter Action Button + Delete Button -->
                                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <!-- 3-letter Action Button -->
                                                    <Button Grid.Column="0"
                                                            Text="{Binding Label}"
                                                            Style="{StaticResource AccentBtn}"
                                                            HeightRequest="34"
                                                            FontSize="12"
                                                            FontAttributes="Bold"
                                                            Padding="6,2"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EEWorkspaceViewModel}}, Path=ExecuteCustomActionCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="{Binding Description}"/>

                                                    <!-- Delete Button -->
                                                    <Button Grid.Column="1"
                                                            Text="✕"
                                                            Style="{StaticResource IconBtn}"
                                                            FontSize="11"
                                                            TextColor="#F78166"
                                                            Padding="4,2"
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EEWorkspaceViewModel}}, Path=DeleteCustomButtonCommand}"
                                                            CommandParameter="{Binding .}"
                                                            ToolTipProperties.Text="Delete / disconnect button"/>
                                                </Grid>

                                                <!-- Row 1: Dropdown UI showing connected action -->
                                                <Picker Grid.Row="1"
                                                        ItemsSource="{Binding AvailableActions}"
                                                        SelectedItem="{Binding ActionName}"
                                                        BackgroundColor="#0D1117"
                                                        TextColor="#58A6FF"
                                                        FontSize="10"
                                                        HeightRequest="30"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Footer link to Settings -->
                    <Border Grid.Row="2" BackgroundColor="#0D1117" Padding="8,8" StrokeThickness="0">
                        <Button Text="⚙ Customize in Settings"
                                Style="{StaticResource ToolBtn}"
                                FontSize="11"
                                HorizontalOptions="Fill"
                                Command="{Binding OpenSettingsCommand}"/>
                    </Border>
                </Grid>
            </Border>

            <!-- ─── Center: Schematic OR Script viewport ──────────────────── -->
            <Grid Grid.Column="{OnIdiom Phone=1, Default=2}">
                <!-- Schematic Viewport -->
                <views:SchematicViewport
                    x:Name="SchematicCanvas"
                    Circuit="{Binding Circuit}"
                    IsVisible="{Binding IsScriptViewActive, Converter={StaticResource InvertedBoolConverter}}"
                    HorizontalOptions="Fill"
                    VerticalOptions="Fill"/>

                <!-- ── Floating Play/Pause FAB ─────────────────────────────── -->
                <Frame IsVisible="{Binding IsScriptViewActive, Converter={StaticResource InvertedBoolConverter}}"
                       ZIndex="50"
                       HorizontalOptions="End"
                       VerticalOptions="End"
                       Margin="20"
                       Padding="0"
                       CornerRadius="32"
                       BackgroundColor="#1C2128"
                       BorderColor="#30363D"
                       HasShadow="True"
                       WidthRequest="56"
                       HeightRequest="56">
                    <Button Text="{Binding PlayPauseFabText}"
                            FontSize="18"
                            Padding="0"
                            WidthRequest="56"
                            HeightRequest="56"
                            CornerRadius="28"
                            BackgroundColor="Transparent"
                            TextColor="{Binding SimPlayBtnColor}"
                            Command="{Binding ToggleSimulationPlaybackCommand}"
                            ToolTipProperties.Text="Play / Pause Simulation"/>
                </Frame>

                <!-- Script Viewport -->
                <Grid IsVisible="{Binding IsScriptViewActive}"
                      BackgroundColor="#0D1117"
                      RowDefinitions="Auto,*,8,200">

                    <!-- Script editor header (Undo/Redo removed per §2.C: schematic history != script text history) -->
                    <Grid Grid.Row="0"
                          BackgroundColor="#161B22"
                          HeightRequest="36"
                          ColumnDefinitions="*,Auto,Auto"
                          Padding="12,0">
                        <Label Grid.Column="0"
                               Text="● script.py"
                               TextColor="#58A6FF"
                               FontSize="12"
                               VerticalOptions="Center"/>
                        <Button Grid.Column="1"
                                Text="▶  Run"
                                Style="{StaticResource AccentBtn}"
                                Command="{Binding RunScriptCommand}"
                                Margin="0,4,8,4"/>
                        <Button Grid.Column="2"
                                Text="Clear"
                                Style="{StaticResource ToolBtn}"
                                Command="{Binding ClearConsoleCommand}"/>
                    </Grid>


                    <!-- Code editor -->
                    <Border Grid.Row="1"
                            BackgroundColor="#0D1117"
                            Padding="0"
                            Stroke="#30363D"
                            StrokeThickness="1"
                            Margin="0">
                        <Editor x:Name="ScriptEditor"
                                Text="{Binding ScriptText}"
                                BackgroundColor="#0D1117"
                                TextColor="#C9D1D9"
                                FontFamily="Courier New"
                                FontSize="13"
                                Placeholder="# Python script…"
                                PlaceholderColor="#484F58"
                                AutoSize="TextChanges"
                                Keyboard="Text"/>
                    </Border>

                    <!-- Splitter -->
                    <BoxView Grid.Row="2" BackgroundColor="#21262D"/>

                    <!-- Console output -->
                    <Grid Grid.Row="3" BackgroundColor="#0D1117" RowDefinitions="Auto,*">
                        <Label Grid.Row="0"
                               Text="Console Output"
                               TextColor="#8B949E"
                               FontSize="11"
                               FontAttributes="Bold"
                               Padding="12,4"/>
                        <ScrollView Grid.Row="1">
                            <Label Text="{Binding ConsoleOutput}"
                                   TextColor="#56D364"
                                   FontFamily="Courier New"
                                   FontSize="12"
                                   Padding="12,4"
                                   LineBreakMode="WordWrap"/>
                        </ScrollView>
                    </Grid>
                </Grid>

                <!-- ─── Waveform Drawer Overlay ─────────────────────────────── -->
                <Grid IsVisible="{Binding IsWaveformDrawerOpen}"
                      VerticalOptions="End"
                      HeightRequest="230"
                      BackgroundColor="#0A0E14"
                      RowDefinitions="36,*">

                    <!-- Drawer Header -->
                    <Grid Grid.Row="0"
                          BackgroundColor="#161B22"
                          ColumnDefinitions="Auto,*,Auto"
                          Padding="12,0">

                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📈 Oscilloscope / Waveforms"
                                   TextColor="#58A6FF"
                                   FontAttributes="Bold"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding WaveformComponent.Reference, StringFormat='[{0}]'}"
                                   TextColor="#56D364"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>

                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                            <Button Text="Simulate"
                                    Style="{StaticResource ToolBtn}"
                                    FontSize="11"
                                    Padding="8,4"
                                    Command="{Binding RunConfiguredSimulationAsyncCommand}"/>

                            <Button Text="✕"
                                    Style="{StaticResource IconBtn}"
                                    FontSize="12"
                                    Padding="6"
                                    Command="{Binding CloseWaveformDrawerCommand}"
                                    ToolTipProperties.Text="Close Waveform Drawer"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <!-- Waveform Oscilloscope Viewport -->
                    <views:WaveformViewport Grid.Row="1"
                                            MonitoredComponent="{Binding WaveformComponent}"
                                            HorizontalOptions="Fill"
                                            VerticalOptions="Fill"/>
                </Grid>
            </Grid>

            <!-- ─── Right panel: Component palette + Properties ────────────── -->
            <Grid Grid.Column="{OnIdiom Phone=1, Default=3}"
                  ZIndex="25"
                  HorizontalOptions="End"
                  WidthRequest="{OnIdiom Phone=240, Default=260}"
                  IsVisible="{Binding IsSidebarVisible}"
                  BackgroundColor="#161B22"
                  RowDefinitions="Auto,*,Auto,Auto">

                <!-- Left border -->
                <BoxView Grid.Row="0" Grid.RowSpan="4"
                         WidthRequest="1" BackgroundColor="#30363D"
                         HorizontalOptions="Start"/>

                <!-- Panel header with close toggle and Description toggle -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Padding="12,8,8,6">
                    <Label Grid.Column="0"
                           Text="COMPONENTS"
                           TextColor="#8B949E"
                           FontSize="11"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           CharacterSpacing="1"/>
                    <Button Grid.Column="1"
                            Text="📋 Description"
                            Style="{StaticResource ToolBtn}"
                            FontSize="10"
                            Padding="6,3"
                            Command="{Binding ToggleDescriptionSidebarCommand}"
                            ToolTipProperties.Text="Open Description &amp; Properties Sidebar"/>
                    <Button Grid.Column="2"
                            Text="✕"
                            Style="{StaticResource IconBtn}"
                            Padding="4"
                            FontSize="12"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTipProperties.Text="Close sidebar"/>
                </Grid>

                <!-- ── Grouped palette — each category has a header + 2-per-row grid ── -->
                <ScrollView Grid.Row="1" Padding="6,4">
                    <VerticalStackLayout Spacing="0"
                                        BindableLayout.ItemsSource="{Binding GroupedPalette}">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:ComponentPaletteGroup">
                                <VerticalStackLayout Spacing="0" Margin="0,0,0,8">

                                    <!-- Category header -->
                                    <Label Text="{Binding Header}"
                                           TextColor="#58A6FF"
                                           FontSize="10"
                                           FontAttributes="Bold"
                                           CharacterSpacing="0.5"
                                           Padding="4,6,4,4"
                                           Margin="0,0,0,2"
                                           BackgroundColor="#0D1117"/>

                                    <!-- 2-per-row FlexLayout of icon tiles -->
                                    <FlexLayout Wrap="Wrap"
                                                JustifyContent="Start"
                                                AlignItems="Start"
                                                BindableLayout.ItemsSource="{Binding Items}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ComponentPaletteItem">
                                                <Border WidthRequest="106"
                                                        Margin="2"
                                                        BackgroundColor="#1C2128"
                                                        Stroke="{Binding Color}"
                                                        StrokeThickness="1"
                                                        ToolTipProperties.Text="{Binding TooltipText}">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="8"/>
                                                    </Border.StrokeShape>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EEWorkspaceViewModel}}, Path=AddComponentToCircuitCommand}"
                                                            CommandParameter="{Binding .}"/>
                                                    </Border.GestureRecognizers>

                                                    <!-- Context flyout -->
                                                    <FlyoutBase.ContextFlyout>
                                                        <MenuFlyout>
                                                            <MenuFlyoutItem Text="{Binding Type, StringFormat='Component: {0}'}" IsEnabled="False"/>
                                                            <MenuFlyoutItem Text="{Binding Description}" IsEnabled="False"/>
                                                            <MenuFlyoutSeparator/>
                                                            <MenuFlyoutItem Text="➕ Insert"
                                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EEWorkspaceViewModel}}, Path=AddComponentToCircuitCommand}"
                                                                            CommandParameter="{Binding .}"/>
                                                        </MenuFlyout>
                                                    </FlyoutBase.ContextFlyout>

                                                    <!-- Icon tile content -->
                                                    <VerticalStackLayout Padding="4,6" Spacing="2">
                                                        <Image
                                                            Source="{Binding ImageSource}"
                                                            WidthRequest="52"
                                                            HeightRequest="42"
                                                            Aspect="AspectFit"
                                                            HorizontalOptions="Center"
                                                            InputTransparent="True"/>
                                                        <Label Text="{Binding Type}"
                                                               TextColor="#8B949E"
                                                               FontSize="9"
                                                               HorizontalOptions="Center"
                                                               HorizontalTextAlignment="Center"
                                                               LineBreakMode="TailTruncation"
                                                               MaxLines="1"/>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </FlexLayout>

                                </VerticalStackLayout>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </ScrollView>

                <!-- Splitter -->
                <BoxView Grid.Row="2" HeightRequest="1" BackgroundColor="#30363D"/>

                <!-- Properties panel -->
                <Grid Grid.Row="3" RowDefinitions="Auto,*" Padding="0" MaximumHeightRequest="130">
                    <Label Grid.Row="0"
                           Text="PROPERTIES"
                           TextColor="#8B949E"
                           FontSize="11"
                           FontAttributes="Bold"
                           Padding="12,6,12,4"
                           CharacterSpacing="1"/>

                    <ScrollView Grid.Row="1" Padding="12,0,12,6">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding ActiveComponentInfo}"
                                   TextColor="#C9D1D9"
                                   FontSize="11"
                                   LineBreakMode="WordWrap"/>
                            <Label Text="{Binding StatusText}"
                                   TextColor="#8B949E"
                                   FontSize="10"
                                   Margin="0,2,0,0"/>
                        </VerticalStackLayout>
                    </ScrollView>
                </Grid>
            </Grid>

            <!-- ── Right-Edge Trigger: Description & Component Sidebar ─────── -->
            <Border Grid.Column="{OnIdiom Phone=1, Default=2}"
                    ZIndex="35"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Margin="0,0,0,0"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="3,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8,0,0,8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Button Text="📋"
                            Style="{StaticResource IconBtn}"
                            TextColor="#E3B341"
                            Command="{Binding ToggleDescriptionSidebarCommand}"
                            ToolTipProperties.Text="Component Description &amp; Properties Sidebar"/>
                    <Button Text="🧩"
                            Style="{StaticResource IconBtn}"
                            TextColor="#58A6FF"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTipProperties.Text="Components Palette Sidebar"/>
                </VerticalStackLayout>
            </Border>

            <!-- ── Description & Properties Sidebar (Right) ────────────────── -->
            <Border Grid.Column="{OnIdiom Phone=1, Default=3}"
                    ZIndex="28"
                    HorizontalOptions="End"
                    WidthRequest="{OnIdiom Phone=260, Default=280}"
                    IsVisible="{Binding IsDescriptionSidebarVisible}"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1">
                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" BackgroundColor="#0D1117" Padding="12,10" ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="6" VerticalOptions="Center">
                            <Label Text="📋" FontSize="14" TextColor="#E3B341" VerticalOptions="Center"/>
                            <Label Text="DESCRIPTION &amp; PROPERTIES"
                                   TextColor="#E6EDF3"
                                   FontSize="11"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   CharacterSpacing="1"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1"
                                Text="✕"
                                Style="{StaticResource IconBtn}"
                                FontSize="11"
                                Padding="4"
                                Command="{Binding ToggleDescriptionSidebarCommand}"
                                ToolTipProperties.Text="Close description sidebar"/>
                    </Grid>

                    <!-- Content -->
                    <ScrollView Grid.Row="1" Padding="12,10">
                        <VerticalStackLayout Spacing="10">
                            <!-- Placeholder when no component is selected -->
                            <VerticalStackLayout IsVisible="{Binding HasSelectedComponent, Converter={StaticResource InvertedBoolConverter}}"
                                                Spacing="8"
                                                Padding="8,24"
                                                HorizontalOptions="Center">
                                <Label Text="🔍" FontSize="32" HorizontalOptions="Center" TextColor="#484F58"/>
                                <Label Text="No Component Selected"
                                       TextColor="#C9D1D9"
                                       FontSize="13"
                                       FontAttributes="Bold"
                                       HorizontalOptions="Center"/>
                                <Label Text="Select any component on the schematic canvas to inspect and edit its live description, rating, and parameters."
                                       TextColor="#8B949E"
                                       FontSize="11"
                                       HorizontalTextAlignment="Center"/>
                            </VerticalStackLayout>

                            <!-- Inspector when component is selected -->
                            <VerticalStackLayout IsVisible="{Binding HasSelectedComponent}" Spacing="10">
                                <!-- Component Card Header -->
                                <Border BackgroundColor="#0D1117" Stroke="#30363D" StrokeThickness="1" Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                        <views:ComponentIconView Grid.Column="0"
                                                                ComponentType="{Binding SelectedComponent.ComponentType}"
                                                                WidthRequest="36"
                                                                HeightRequest="36"/>
                                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                            <Label Text="{Binding SelectedComponent.Reference}"
                                                   TextColor="#58A6FF"
                                                   FontSize="14"
                                                   FontAttributes="Bold"/>
                                            <Label Text="{Binding SelectedComponent.ComponentType}"
                                                   TextColor="#8B949E"
                                                   FontSize="11"/>
                                        </VerticalStackLayout>

                                        <!-- Breakdown status indicator badge -->
                                        <Border Grid.Column="2"
                                                Padding="6,3"
                                                BackgroundColor="#3D1214"
                                                Stroke="#F85149"
                                                IsVisible="{Binding SelectedComponent.IsBrokenDown}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4"/>
                                            </Border.StrokeShape>
                                            <Label Text="⚠️ OVERLOAD"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#FF7B72"/>
                                        </Border>

                                        <Border Grid.Column="2"
                                                Padding="6,3"
                                                BackgroundColor="#132B1E"
                                                Stroke="#238636"
                                                IsVisible="{Binding SelectedComponent.IsBrokenDown, Converter={StaticResource InvertedBoolConverter}}">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="4"/>
                                            </Border.StrokeShape>
                                            <Label Text="✓ NORMAL"
                                                   FontSize="9"
                                                   FontAttributes="Bold"
                                                   TextColor="#56D364"/>
                                        </Border>
                                    </Grid>
                                </Border>

                                <!-- Reference / Name -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="REFERENCE / NAME" TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditName}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12" HeightRequest="34"/>
                                </VerticalStackLayout>

                                <!-- Description & Notes (Editable!) -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="DESCRIPTION &amp; NOTES" TextColor="#E3B341" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Editor Text="{Binding EditDescription}"
                                            HeightRequest="65"
                                            BackgroundColor="#0D1117"
                                            TextColor="#C9D1D9"
                                            FontSize="11"
                                            Placeholder="Enter component description or engineering notes…"/>
                                </VerticalStackLayout>

                                <!-- Primary Parameter -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="{Binding EditParamName}" TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditParamValue}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12" HeightRequest="34"/>
                                </VerticalStackLayout>

                                <!-- Max Breaking Current (Editable!) -->
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="MAX BREAKING CURRENT (A)" TextColor="#F85149" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditBreakingCurrent}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#FF7B72" FontSize="12" HeightRequest="34"/>
                                </VerticalStackLayout>

                                <!-- Live Measurements Panel -->
                                <Border BackgroundColor="#0D1117" Stroke="#30363D" StrokeThickness="1" Padding="10,8">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="6"/>
                                    </Border.StrokeShape>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="LIVE SIMULATION MEASUREMENTS" TextColor="#8B949E" FontSize="9" FontAttributes="Bold" CharacterSpacing="1"/>
                                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" RowSpacing="4">
                                            <Label Grid.Row="0" Grid.Column="0" Text="Voltage Drop:" TextColor="#8B949E" FontSize="11"/>
                                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding SelectedComponent.LiveVoltage, StringFormat='{0:F3} V'}" TextColor="#56D364" FontSize="11" FontAttributes="Bold" HorizontalOptions="End"/>
                                            <Label Grid.Row="1" Grid.Column="0" Text="Branch Current:" TextColor="#8B949E" FontSize="11"/>
                                            <Label Grid.Row="1" Grid.Column="1" Text="{Binding SelectedComponent.LiveCurrent, StringFormat='{0:F4} A'}" TextColor="#79C0FF" FontSize="11" FontAttributes="Bold" HorizontalOptions="End"/>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Quick Action Buttons: Rotate, Copy, Delete -->
                                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6" Margin="0,4,0,0">
                                    <Button Grid.Column="0" Text="⟳ Rotate" Style="{StaticResource ToolBtn}" FontSize="10" Padding="4"
                                            Command="{Binding RotateSelectedComponentCommand}"/>
                                    <Button Grid.Column="1" Text="📋 Copy" Style="{StaticResource ToolBtn}" FontSize="10" Padding="4"
                                            Command="{Binding CopySelectedComponentCommand}"/>
                                    <Button Grid.Column="2" Text="🗑 Delete" Style="{StaticResource ToolBtn}" TextColor="#F85149" FontSize="10" Padding="4"
                                            Command="{Binding DeleteSelectedComponentCommand}"/>
                                </Grid>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Footer: Save / Apply Button -->
                    <Border Grid.Row="2" BackgroundColor="#0D1117" Padding="8,8" StrokeThickness="0">
                        <Button Text="✓ Save Description Changes"
                                Style="{StaticResource AccentBtn}"
                                FontSize="11"
                                HorizontalOptions="Fill"
                                Command="{Binding ApplyDescriptionSidebarChangesCommand}"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- STATUS BAR                                                       -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="2"
              BackgroundColor="#161B22"
              HeightRequest="26"
              Padding="12,0"
              ColumnDefinitions="*,Auto">

            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="1"
                     BackgroundColor="#30363D"
                     VerticalOptions="Start"/>

            <Label Grid.Column="0"
                   Text="{Binding StatusText}"
                   TextColor="#8B949E"
                   FontSize="11"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="{Binding ActiveTool, StringFormat='Tool: {0}'}"
                   TextColor="#484F58"
                   FontSize="11"
                   VerticalOptions="Center"/>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════ -->
        <!-- COMPONENT EDIT DIALOG MODAL OVERLAY                              -->
        <!-- ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsEditDialogVisible}"
              BackgroundColor="#99000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border MaximumWidthRequest="480"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Dialog Header -->
                    <Grid Grid.Row="0" BackgroundColor="#1C2128" Padding="16,12" ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="⚙" FontSize="16" TextColor="#58A6FF" VerticalOptions="Center"/>
                            <Label Text="{Binding EditType, StringFormat='Edit {0}'}"
                                   TextColor="#C9D1D9"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                            <Label Text="{Binding EditName, StringFormat='[{0}]'}"
                                   TextColor="#8B949E"
                                   FontSize="12"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="✕"
                                Style="{StaticResource IconBtn}"
                                FontSize="12"
                                Padding="4"
                                Command="{Binding CloseEditDialogCommand}"
                                ToolTipProperties.Text="Close Dialog"/>
                    </Grid>

                    <!-- Tab Navigation Bar -->
                    <Grid Grid.Row="1" BackgroundColor="#0D1117" ColumnDefinitions="*,*,*,*" Padding="8,6" ColumnSpacing="4">
                        <Button Grid.Column="0" Text="⚡ General"
                                Style="{StaticResource PaletteBtn}"
                                FontSize="11" Padding="4"
                                Command="{Binding SelectEditTabCommand}"
                                CommandParameter="General"/>
                        <Button Grid.Column="1" Text="〰 Waveform"
                                Style="{StaticResource PaletteBtn}"
                                FontSize="11" Padding="4"
                                Command="{Binding SelectEditTabCommand}"
                                CommandParameter="Waveform"/>
                        <Button Grid.Column="2" Text="⚙ Advanced"
                                Style="{StaticResource PaletteBtn}"
                                FontSize="11" Padding="4"
                                Command="{Binding SelectEditTabCommand}"
                                CommandParameter="Advanced"/>
                        <Button Grid.Column="3" Text="📍 Pins"
                                Style="{StaticResource PaletteBtn}"
                                FontSize="11" Padding="4"
                                Command="{Binding SelectEditTabCommand}"
                                CommandParameter="Pins"/>
                    </Grid>

                    <!-- Dialog Form Content Area -->
                    <ScrollView Grid.Row="2" MaximumHeightRequest="420" Padding="16,12">
                        <VerticalStackLayout Spacing="12">

                            <!-- ─── TAB 1: GENERAL & ELECTRICAL ─────────────── -->
                            <VerticalStackLayout Spacing="12" IsVisible="{Binding IsEditTabGeneral}">
                                <!-- Eye (Probe) and Graph (Waveform) Icon Toggles -->
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,2,0,4">
                                    <Button Grid.Column="0"
                                            Text="👁 Live Probe"
                                            Style="{StaticResource PaletteBtn}"
                                            TextColor="#56D364"
                                            BorderColor="#56D364"
                                            Command="{Binding ToggleEditLiveProbeCommand}"
                                            ToolTipProperties.Text="Toggle Realtime Voltage &amp; Current Display"/>
                                    <Button Grid.Column="1"
                                            Text="📈 Waveform"
                                            Style="{StaticResource PaletteBtn}"
                                            TextColor="#79C0FF"
                                            BorderColor="#79C0FF"
                                            Command="{Binding ToggleEditWaveformCommand}"
                                            ToolTipProperties.Text="Toggle Oscilloscope Waveform Drawer"/>
                                </Grid>

                                <!-- Name / Reference -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="COMPONENT NAME / REFERENCE"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditName}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Primary Parameter (Resistance, Capacitance, Voltage, etc.) -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding EditParamName}"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditParamValue}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Max Breaking Current (device breakdown threshold) -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="MAX BREAKING CURRENT (A) [Overload Warning Threshold]"
                                           TextColor="#F85149" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditBreakingCurrent}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#FF7B72" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Component Description / Notes -->
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="DESCRIPTION &amp; NOTES"
                                           TextColor="#E3B341" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Editor Text="{Binding EditDescription}" HeightRequest="60" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                </VerticalStackLayout>

                                <!-- Wire Parasitic Resistance -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsWireComponent}">
                                    <Label Text="WIRE RESISTANCE (Ω) [0 = Ideal]"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditWireResistance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- BJT Polarity -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsBjtComponent}">
                                    <Label Text="TRANSISTOR POLARITY (NPN / PNP)"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditBjtPolarity}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- MOSFET Channel -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsMosfetComponent}">
                                    <Label Text="MOSFET CHANNEL (NChannel / PChannel)"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditMosfetChannel}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- JFET Channel -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsJfetComponent}">
                                    <Label Text="JFET CHANNEL (NChannel / PChannel)"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditJfetChannel}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Controlling Source (for CCVS, CCCS, CurrentSwitch) -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsControlledSourceComponent}">
                                    <Label Text="CONTROLLING SOURCE (Optional if sensing pins wired)"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditControllingSource}" Placeholder="e.g. V1" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Switch Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsSwitchComponent}">
                                    <Label Text="SWITCH PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="OFF Resistance (Roff, Ω)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditResistanceOff}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Threshold (V or A)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditThreshold}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Hysteresis (V or A)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditHysteresis}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Mutual Inductance Coupled Pair -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsMutualInductanceComponent}">
                                    <Label Text="COUPLED INDUCTORS"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <Entry Grid.Column="0" Text="{Binding EditInductor1}" Placeholder="Inductor 1 (L1)" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        <Entry Grid.Column="1" Text="{Binding EditInductor2}" Placeholder="Inductor 2 (L2)" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Transmission Line Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsTransmissionLineComponent}">
                                    <Label Text="TRANSMISSION LINE PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Impedance Z0 (Ω)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditCharacteristicImpedance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Delay TD (s)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditDelayTime}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Frequency F (Hz)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLineFrequency}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Normalized Length NL" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditNormalizedLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Voltage Delay Element -->
                                <VerticalStackLayout Spacing="4" IsVisible="{Binding IsVoltageDelayComponent}">
                                    <Label Text="PROPAGATION DELAY (s)" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditDelayTime}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="13"/>
                                </VerticalStackLayout>

                                <!-- Clock Pulse Generator -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsClockComponent}">
                                    <Label Text="CLOCK GENERATOR PARAMETERS (Logisim &amp; Live Sim)" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Frequency (Hz)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockFrequency}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Duty Cycle (0.01 - 0.99)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockDutyCycle}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="High Voltage (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockHighVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Low Voltage (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockLowVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="High Dur (ticks)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockHighDuration}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Low Dur (ticks)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockLowDuration}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="Phase (ticks)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditClockPhase}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Named I/O Pin -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsPinComponent}">
                                    <Label Text="PIN I/O PORT PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Direction (Input / Output)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPinDirection}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Bit Width (1 - 32)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPinBitWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Behavior (Tristate/PullUp/PullDown)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPinBehavior}" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
