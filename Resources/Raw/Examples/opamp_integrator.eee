  "Application": "EESimulator",
  "Title": "Op-Amp Integrator",
  "Description": "Operational amplifier practical integrator circuit with dual split DC supply (+15V, -15V, middle GND reference), input resistor Rin = 10 kOhm, feedback capacitor Cf = 1.0 uF, parallel DC bleed resistor Rshunt = 100 kOhm for practical DC operating point stability (Vout = -5.0V), ramp rate dV/dt = -Vin/(Rin*Cf) = -50 V/s, and 10 kOhm load.",
  "LogicalGridRowSpacing": 100.0,
  "LogicalGridColumnSpacing": 100.0,
  "Author": "EESimulator Examples",
