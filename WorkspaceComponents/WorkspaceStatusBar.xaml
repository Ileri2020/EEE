<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceStatusBar" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid Grid.Row="2"
              BackgroundColor="#161B22"
              HeightRequest="26"
              Padding="12,0"
              ColumnDefinitions="*,Auto">

            <BoxView Grid.ColumnSpan="2"
                     HeightRequest="1"
                     BackgroundColor="#30363D"
                     VerticalOptions="Start"/>

            <Label Grid.Column="0"
                   Text="{Binding StatusText}"
                   TextColor="#8B949E"
                   FontSize="11"
                   VerticalOptions="Center"/>

            <Label Grid.Column="1"
                   Text="{Binding ActiveTool, StringFormat='Tool: {0}'}"
                   TextColor="#484F58"
                   FontSize="11"
                   VerticalOptions="Center"/>
        </Grid>
</ContentView>
