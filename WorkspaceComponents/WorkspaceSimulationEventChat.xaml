<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceSimulationEventChat" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Border IsVisible="{Binding IsSimulationEventChatVisible}"
                ZIndex="240" HorizontalOptions="End" VerticalOptions="End"
                Margin="0,0,20,40" Padding="12,8"
                BackgroundColor="#1C2128" Stroke="#58A6FF" StrokeThickness="1">
            <Border.StrokeShape><RoundRectangle CornerRadius="20"/></Border.StrokeShape>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" MaximumWidthRequest="340">
                <Label Text="{Binding SimulationEventChatMessage}" TextColor="#C9D1D9" FontSize="11"
                       LineBreakMode="WordWrap" VerticalOptions="Center"/>
                <Button Grid.Column="1" Text="✕" Style="{StaticResource IconBtn}" FontSize="10" Padding="2"
                        Command="{Binding DismissSimulationEventChatCommand}"/>
            </Grid>
        </Border>
</ContentView>
