                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Value (Hex / Integer)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditConstantValue}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Bit Width (1-32)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditConstantBitWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Voltage High (V)" TextColor="#8B949E" FontSize="10"/>
