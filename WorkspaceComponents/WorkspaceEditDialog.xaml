                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Voltage Low (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditConstantVoltageLow}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- 74-Series TTL package options -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsTtlPackageComponent}">
                                    <Label Text="74-SERIES TTL PACKAGE" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="Expose VCC and GND pins" TextColor="#C9D1D9" FontSize="11" VerticalOptions="Center"/>
                                        <Switch Grid.Column="1" IsToggled="{Binding EditTtlExposeSupplyPins}"/>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Grid.Column="0" Text="Show internal structure" TextColor="#C9D1D9" FontSize="11" VerticalOptions="Center"/>
                                        <Switch Grid.Column="1" IsToggled="{Binding EditTtlShowInternalStructure}"/>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Do Not Connect Marker -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsDoNotConnectComponent}">
                                    <Label Text="DO NOT CONNECT (DNC) MARKER" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Bit Width (1-32)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditDncBitWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- Lossy Transmission Line -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsLossyTransmissionLineComponent}">
                                    <Label Text="LOSSY TRANSMISSION LINE (RLGC MODEL)" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Resistance R (Ω/m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLossyResistance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Inductance L (H/m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLossyInductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Conductance G (S/m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLossyConductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Capacitance C (F/m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLossyCapacitance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="Length (m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditLossyLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Coaxial Cable -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsCoaxialCableComponent}">
                                    <Label Text="COAXIAL CABLE PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Impedance Z0 (Ω)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditCoaxZ0}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Velocity Factor VF (0.1 - 1.0)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditCoaxVF}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Cable Length (m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditCoaxLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Attenuation (dB/m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditCoaxAttenuation}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Microstrip Line -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsMicrostripLineComponent}">
                                    <Label Text="PCB MICROSTRIP LINE PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Trace Width W (m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditMicrostripWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Substrate Height H (m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditMicrostripHeight}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Dielectric Constant (Er)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditMicrostripEr}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Trace Length (m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditMicrostripLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- ─── TAB 2: AC & WAVEFORMS ───────────────────── -->
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditTabWaveform}">
                                <VerticalStackLayout Spacing="8" IsVisible="{Binding IsSourceComponent}">
                                    <Label Text="WAVEFORM TYPE (DC, SINE, PULSE, AM, SFFM, PWL)"
                                           TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>
                                    <Entry Text="{Binding EditWaveformType}" BackgroundColor="#0D1117" TextColor="#56D364" FontSize="13"/>

                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="AC Magnitude (V/A)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditAcMagnitude}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="AC Phase (°)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditAcPhase}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label Text="SINE WAVEFORM PARAMETERS"
                                           TextColor="#79C0FF" FontSize="10" FontAttributes="Bold" Margin="0,4,0,0"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Offset (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSineOffset}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Amplitude (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSineAmplitude}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="Freq (Hz)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSineFrequency}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>

                                    <Label Text="PULSE WAVEFORM PARAMETERS"
                                           TextColor="#79C0FF" FontSize="10" FontAttributes="Bold" Margin="0,4,0,0"/>
                                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Initial (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPulseInitial}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Pulsed (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPulsePulsed}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="2" Spacing="2">
                                            <Label Text="Period (s)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditPulsePeriod}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <Border BackgroundColor="#0D1117" Stroke="#30363D" Padding="12" IsVisible="{Binding IsSourceComponent, Converter={StaticResource InvertedBoolConverter}}">
                                    <Label Text="📈 This component is passive/non-generator. Waveforms through this component can be observed in the Oscilloscope drawer below."
                                           TextColor="#8B949E" FontSize="12" LineBreakMode="WordWrap"/>
                                </Border>
                            </VerticalStackLayout>

                            <!-- ─── TAB 3: ADVANCED & MODEL PARAMETERS ──────── -->
                            <VerticalStackLayout Spacing="10" IsVisible="{Binding IsEditTabAdvanced}">
                                <!-- Diode Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsDiodeComponent}">
                                    <Label Text="DIODE SPICE MODEL PARAMETERS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Emission Coeff (N)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditEmissionCoefficient}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Breakdown V (Bv)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditBreakdownVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Series Res (Rs, Ω)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSeriesResistance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Junction Cap (Cj0, F)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditJunctionCapacitance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- BJT Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsBjtComponent}">
                                    <Label Text="BJT TRANSISTOR MODEL" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Forward Beta (Bf)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditGainBeta}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Early Voltage (Vaf, V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditEarlyVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- MOSFET Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsMosfetComponent}">
                                    <Label Text="MOSFET LEVEL 1 MODEL" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Threshold V (Vto)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditThresholdVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Transconductance (Kp)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditTransconductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Width (W, m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditChannelWidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Length (L, m)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditChannelLength}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- JFET Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsJfetComponent}">
                                    <Label Text="JFET SHICHMAN-HODGES MODEL" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Pinch-off V (Vto, V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditThresholdVoltage}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Transconductance (Beta, A/V²)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditTransconductance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Channel Mod (Lambda, 1/V)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditLambda}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>

                                <!-- OpAmp Model Parameters -->
                                <VerticalStackLayout Spacing="6" IsVisible="{Binding IsOpAmpComponent}">
                                    <Label Text="OP-AMP FREQUENCY &amp; RAILS" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="GBW (Hz)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditGainBandwidth}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Slew Rate (V/μs)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSlewRate}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Vcc+ Rail (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSupplyPositive}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                                            <Label Text="Vee- Rail (V)" TextColor="#8B949E" FontSize="10"/>
                                            <Entry Text="{Binding EditSupplyNegative}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>

                                <!-- Parasitics, Temperature, and Initial Conditions -->
                                <Label Text="PARASITICS &amp; TEMPERATURE MODELING" TextColor="#79C0FF" FontSize="10" FontAttributes="Bold"/>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="Temperature (°C)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditTemperature}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="Initial Condition (IC)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditInitialCondition}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Grid>
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <VerticalStackLayout Grid.Column="0" Spacing="2">
                                        <Label Text="TempCo TC1" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditTempCoeff1}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="ESR / Rdc (Ω)" TextColor="#8B949E" FontSize="10"/>
                                        <Entry Text="{Binding EditEquivalentSeriesResistance}" Keyboard="Numeric" BackgroundColor="#0D1117" TextColor="#C9D1D9" FontSize="12"/>
                                    </VerticalStackLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- ─── TAB 4: NODES & TERMINALS ────────────────── -->
                            <VerticalStackLayout Spacing="6" IsVisible="{Binding IsEditTabPins}">
                                <Label Text="COMPONENT TERMINAL PINS"
                                       TextColor="#8B949E" FontSize="10" FontAttributes="Bold" CharacterSpacing="1"/>

                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding EditPins}" Spacing="6">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PinEditItem">
                                            <Grid ColumnDefinitions="60,*" ColumnSpacing="8">
                                                <Label Grid.Column="0"
                                                       Text="{Binding Id, StringFormat='Pin: {0}'}"
                                                       TextColor="#8B949E"
                                                       FontSize="11"
                                                       VerticalOptions="Center"/>
                                                <Entry Grid.Column="1"
                                                       Text="{Binding Name}"
                                                       BackgroundColor="#0D1117"
                                                       TextColor="#C9D1D9"
                                                       FontSize="12"
                                                       HeightRequest="36"/>
                                            </Grid>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Dialog Actions Footer -->
                    <Grid Grid.Row="3" BackgroundColor="#1C2128" Padding="14,10" ColumnDefinitions="Auto,*,Auto,Auto">
                        <Button Grid.Column="0"
                                Text="Delete"
                                Style="{StaticResource ToolBtn}"
                                TextColor="#F78166"
                                Command="{Binding DeleteEditingComponentCommand}"/>

                        <Button Grid.Column="2"
                                Text="Cancel"
                                Style="{StaticResource ToolBtn}"
                                Command="{Binding CloseEditDialogCommand}"
                                Margin="0,0,6,0"/>

                        <Button Grid.Column="3"
                                Text="Apply"
                                Style="{StaticResource AccentBtn}"
                                Command="{Binding ApplyEditDialogCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</ContentView>
