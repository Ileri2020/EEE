<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceNetlistDialog" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid Grid.RowSpan="3"
              IsVisible="{Binding IsNetlistModalVisible}"
              BackgroundColor="#BB000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border MaximumWidthRequest="540"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Margin="16">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" BackgroundColor="#1C2128" Padding="16,12" ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                            <Label Text="📄" FontSize="16" TextColor="#58A6FF" VerticalOptions="Center"/>
                            <Label Text="Generated SPICE Netlist"
                                   TextColor="#C9D1D9"
                                   FontSize="14"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="✕"
                                Style="{StaticResource IconBtn}"
                                FontSize="12"
                                Padding="4"
                                Command="{Binding CloseSpiceNetlistCommand}"/>
                    </Grid>

                    <!-- Content -->
                    <ScrollView Grid.Row="1" MaximumHeightRequest="400" Padding="16,12">
                        <Editor Text="{Binding GeneratedSpiceNetlist}"
                                IsReadOnly="True"
                                FontFamily="Consolas, monospace"
                                FontSize="12"
                                TextColor="#56D364"
                                BackgroundColor="#0D1117"/>
                    </ScrollView>

                    <!-- Footer -->
                    <Grid Grid.Row="2" BackgroundColor="#1C2128" Padding="14,10" ColumnDefinitions="*,Auto,Auto,Auto">
                        <Button Grid.Column="1"
                                Text="📋 Copy to Clipboard"
                                Style="{StaticResource AccentBtn}"
                                Command="{Binding CopySpiceNetlistCommand}"
                                Margin="0,0,6,0"/>
                        <Button Grid.Column="2"
                                Text="Close"
                                Style="{StaticResource ToolBtn}"
                                Command="{Binding CloseSpiceNetlistCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</ContentView>
