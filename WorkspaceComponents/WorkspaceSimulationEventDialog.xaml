<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceSimulationEventDialog" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid IsVisible="{Binding IsSimulationEventDialogVisible}" ZIndex="250" BackgroundColor="#AA000000" Padding="16">
            <Border MaximumWidthRequest="420" HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#161B22" Stroke="#D2A8FF" StrokeThickness="1" Padding="16">
                <Border.StrokeShape><RoundRectangle CornerRadius="10"/></Border.StrokeShape>
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding SimulationEventDialogTitle}" TextColor="#D2A8FF" FontSize="14" FontAttributes="Bold"/>
                    <Label Text="{Binding SimulationEventDialogMessage}" TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                    <Button Text="OK" Style="{StaticResource AccentBtn}" HorizontalOptions="End"
                            Command="{Binding CloseSimulationEventDialogCommand}"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
</ContentView>
