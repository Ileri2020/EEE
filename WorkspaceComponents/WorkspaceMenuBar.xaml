<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceMenuBar" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid Grid.Row="0" BackgroundColor="#161B22" HeightRequest="44">
                        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                            <HorizontalStackLayout Spacing="8" Padding="8,0" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                <!-- Logo -->
                  <Image Source="ee_engine.svg"
                      WidthRequest="26"
                      HeightRequest="26"
                      VerticalOptions="Center"
                      Margin="0,0,2,0"/>
                <Label Text="EE Engine"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="#C9D1D9"
                       VerticalOptions="Center"
                       Margin="0,0,4,0"/>

                <BoxView WidthRequest="1" HeightRequest="20" Color="#30363D" VerticalOptions="Center" Margin="4,0"/>

                <Button Text="File ▾"
                        Style="{StaticResource ToolBtn}"
                        TextColor="#C9D1D9"
                        FontSize="12"
                        Padding="8,5"
                        Command="{Binding ToggleFileMenuCommand}"
                        ToolTipProperties.Text="Open or save a project"/>
                      </HorizontalStackLayout>

                      <Label Text="{Binding ProjectName}"
                          TextColor="#8B949E"
                          FontSize="12"
                          VerticalOptions="Center"
                          Margin="8,0"/>

                      <!-- Toolbar actions -->
                      <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                    <!-- Rotate selected -->
                    <Button Text="⟳" Style="{StaticResource IconBtn}"

                            TextColor="#D2A8FF"
                            Command="{Binding RotateSelectedComponentCommand}"
                            ToolTipProperties.Text="Rotate Selected Component 90°"/>
                    <BoxView WidthRequest="1" HeightRequest="24" Color="#30363D" VerticalOptions="Center" Margin="2,0"/>
                    <!-- Script / Schematic toggle ('SCR' label — §2.E; &lt;/&gt; entity breaks MAUI source gen) -->
                    <Button Text="SCR" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleViewportCommand}"
                            ToolTipProperties.Text="Cycle Schematic → Script → Analytics view"/>
                    <!-- Waveform -->
                    <Button Text="📈" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleWaveformDrawerCommand}"
                            ToolTipProperties.Text="Waveform / Oscilloscope"/>
                    <!-- Sim setup -->
                    <Button Text="⚡" Style="{StaticResource IconBtn}"
                            TextColor="#E3B341"
                            Command="{Binding OpenSimSettingsCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTipProperties.Text="Simulation Setup"/>
                    <!-- Examples Library -->
                    <Button Text="📚" Style="{StaticResource IconBtn}"
                            TextColor="#58A6FF"
                            Command="{Binding OpenExamplesPageCommand}"
                            ToolTipProperties.Text="Circuit Examples Library (.eee)"/>
                    <!-- Settings -->
                    <Button Text="⚙" Style="{StaticResource IconBtn}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTipProperties.Text="Settings"/>
                        <Button Text="👤" Style="{StaticResource IconBtn}"
                            Command="{Binding OpenAccountCommand}"
                            ToolTipProperties.Text="Account and Gemini API key"/>
                    <!-- Help -->
                    <Button Text="❓" Style="{StaticResource IconBtn}"
                            Command="{Binding ToggleHelpCommand}"
                            ToolTipProperties.Text="Help"/>

                                </HorizontalStackLayout>
                            </HorizontalStackLayout>
                        </ScrollView>
            <!-- Bottom border line -->
                        <BoxView HeightRequest="1"
                     BackgroundColor="#30363D"
                     VerticalOptions="End"/>
        </Grid>
</ContentView>
