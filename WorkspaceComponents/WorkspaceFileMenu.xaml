<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceFileMenu" x:DataType="vm:EEWorkspaceViewModel" IsVisible="{Binding IsFileMenuOpen}" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <VerticalStackLayout Grid.RowSpan="3"
                             HorizontalOptions="Start"
                             VerticalOptions="Start"
                             Margin="8,48,0,0"
                             ZIndex="20"
                             Spacing="2">
            <Border BackgroundColor="#161B22" Stroke="#30363D" StrokeThickness="1" Padding="6">
                <VerticalStackLayout Spacing="2">
                    <Button Text="Open project..."
                            Style="{StaticResource ToolBtn}"
                            HorizontalOptions="Fill"
                            Command="{Binding OpenProjectCommand}"/>
                    <Button Text="Save"
                            Style="{StaticResource ToolBtn}"
                            HorizontalOptions="Fill"
                            TextColor="#56D364"
                            Command="{Binding SaveProjectCommand}"/>
                    <Button Text="Save As..."
                            Style="{StaticResource ToolBtn}"
                            HorizontalOptions="Fill"
                            TextColor="#79C0FF"
                            Command="{Binding SaveProjectAsCommand}"/>
                    <Button Text="Save to database"
                            Style="{StaticResource ToolBtn}"
                            HorizontalOptions="Fill"
                            TextColor="#D2A8FF"
                            Command="{Binding SaveProjectToServerCommand}"/>
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
</ContentView>
