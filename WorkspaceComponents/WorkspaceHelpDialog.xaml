<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceHelpDialog" x:DataType="vm:EEWorkspaceViewModel" IsVisible="{Binding IsHelpVisible}" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid Grid.RowSpan="3"
              BackgroundColor="#BB000000"
              HorizontalOptions="Fill"
              VerticalOptions="Fill">

            <Border MaximumWidthRequest="520"
                    VerticalOptions="Center"
                    HorizontalOptions="Center"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="14"/>
                </Border.StrokeShape>

                <Grid RowDefinitions="Auto,*,Auto">

                    <!-- Help Dialog Header -->
                    <Grid Grid.Row="0" BackgroundColor="#1C2128" Padding="18,14" ColumnDefinitions="*,Auto">
                        <HorizontalStackLayout Grid.Column="0" Spacing="10" VerticalOptions="Center">
                            <Label Text="❓" FontSize="18" TextColor="#58A6FF" VerticalOptions="Center"/>
                            <Label Text="Controls &amp; Help"
                                   TextColor="#C9D1D9"
                                   FontSize="15"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <Button Grid.Column="1" Text="✕"
                                Style="{StaticResource IconBtn}"
                                FontSize="13"
                                Padding="5"
                                Command="{Binding ToggleHelpCommand}"
                                ToolTipProperties.Text="Close Help"/>
                    </Grid>

                    <!-- Help Content -->
                    <ScrollView Grid.Row="1" MaximumHeightRequest="500" Padding="18,14">
                        <VerticalStackLayout Spacing="14">

                            <!-- Shared toolbar controls -->
                            <Label Text="WORKSPACE BUTTONS"
                                   TextColor="#58A6FF"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.5"/>

                            <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="6" ColumnSpacing="12">
                                <!-- Row 0 -->
                                <Label Grid.Row="0" Grid.Column="0" Text="Select" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="Choose a component, connection, or pin." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 1 -->
                                <Label Grid.Row="1" Grid.Column="0" Text="Wire" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="Choose a source pin, then a destination pin or junction point." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 2 -->
                                <Label Grid.Row="2" Grid.Column="0" Text="Pan" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="Drag in the viewport to move the workspace." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 3 -->
                                <Label Grid.Row="3" Grid.Column="0" Text="Move" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="3" Grid.Column="1" Text="Select a component, choose Move, then drag in the viewport." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 4 -->
                                <Label Grid.Row="4" Grid.Column="0" Text="Rotate" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="4" Grid.Column="1" Text="Rotate the selected component by 90 degrees." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 5 -->
                                <Label Grid.Row="5" Grid.Column="0" Text="Zoom + / −" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="5" Grid.Column="1" Text="Use the sidebar buttons to adjust viewport magnification." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 6 -->
                                <Label Grid.Row="6" Grid.Column="0" Text="Recenter" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="6" Grid.Column="1" Text="Center the workspace on the circuit." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 7 -->
                                <Label Grid.Row="7" Grid.Column="0" Text="Fit" TextColor="#E3B341" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="7" Grid.Column="1" Text="Center and scale the circuit to fit the viewport." TextColor="#C9D1D9" FontSize="12"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#30363D" Margin="0,4"/>

                            <!-- Other sidebar buttons -->
                            <Label Text="OTHER SIDEBAR BUTTONS"
                                   TextColor="#56D364"
                                   FontSize="13"
                                   FontAttributes="Bold"
                                   CharacterSpacing="0.5"/>

                            <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto"
                                  RowSpacing="6" ColumnSpacing="12">
                                <!-- Row 0 -->
                                <Label Grid.Row="0" Grid.Column="0" Text="Undo / Redo" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="0" Grid.Column="1" Text="Reverse or restore the last circuit edit." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 1 -->
                                <Label Grid.Row="1" Grid.Column="0" Text="Properties" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="1" Grid.Column="1" Text="Edit the selected component." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 2 -->
                                <Label Grid.Row="2" Grid.Column="0" Text="Copy / Delete" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="2" Grid.Column="1" Text="Duplicate or remove the selected item." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 3 -->
                                <Label Grid.Row="3" Grid.Column="0" Text="Live measurements" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="3" Grid.Column="1" Text="Show or hide circuit measurements." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 4 -->
                                <Label Grid.Row="4" Grid.Column="0" Text="Waveform" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="4" Grid.Column="1" Text="Plot signals from the selected component." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 5 -->
                                <Label Grid.Row="5" Grid.Column="0" Text="Custom controls" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="5" Grid.Column="1" Text="Run configured actions from the control sidebar." TextColor="#C9D1D9" FontSize="12"/>
                                <!-- Row 6 -->
                                <Label Grid.Row="6" Grid.Column="0" Text="Component palette" TextColor="#56D364" FontSize="12" FontAttributes="Bold"/>
                                <Label Grid.Row="6" Grid.Column="1" Text="Add components with the palette buttons." TextColor="#C9D1D9" FontSize="12"/>
                            </Grid>

                            <BoxView HeightRequest="1" Color="#30363D" Margin="0,4"/>

                            <Label Text="• Use the 👁 Live Probe toggle in the edit dialog to display real-time voltage &amp; current on a component."
                                   TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>
                            <Label Text="• Use the 📈 Waveform toggle to open the oscilloscope drawer for a component."
                                   TextColor="#C9D1D9" FontSize="12" LineBreakMode="WordWrap"/>

                        </VerticalStackLayout>
                    </ScrollView>

                    <!-- Close Footer -->
                    <Grid Grid.Row="2" BackgroundColor="#1C2128" Padding="14,10" HorizontalOptions="Fill">
                        <Button Text="Got it!"
                                Style="{StaticResource AccentBtn}"
                                HorizontalOptions="End"
                                Command="{Binding ToggleHelpCommand}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
</ContentView>
