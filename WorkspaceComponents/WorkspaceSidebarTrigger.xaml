<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceSidebarTrigger" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Border Grid.Column="{OnIdiom Phone=1, Default=2}"
                    ZIndex="35"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Margin="0,0,0,0"
                    BackgroundColor="#161B22"
                    Stroke="#30363D"
                    StrokeThickness="1"
                    Padding="3,6">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="8,0,0,8"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="6">
                    <Button Text="📋"
                            Style="{StaticResource IconBtn}"
                            TextColor="#E3B341"
                            Command="{Binding ToggleDescriptionSidebarCommand}"
                            ToolTipProperties.Text="Component Description &amp; Properties Sidebar"/>
                    <Button Text="🧩"
                            Style="{StaticResource IconBtn}"
                            TextColor="#58A6FF"
                            Command="{Binding ToggleSidebarCommand}"
                            ToolTipProperties.Text="Components Palette Sidebar"/>
                </VerticalStackLayout>
            </Border>
</ContentView>
