<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:EEE.ViewModels" xmlns:models="clr-namespace:EEE.Services" xmlns:core="clr-namespace:EESimulator.Core.Models" xmlns:views="clr-namespace:EESimulator.App.Views" xmlns:parts="clr-namespace:EEE.WorkspaceComponents" x:Class="EEE.WorkspaceComponents.WorkspaceLeftToolbar" x:DataType="vm:EEWorkspaceViewModel" BackgroundColor="Transparent">
    <ContentView.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="WorkspacePageResources.xaml" /></ResourceDictionary.MergedDictionaries></ResourceDictionary></ContentView.Resources>
    <Grid Grid.Column="0"
                  BackgroundColor="#161B22"
                  RowDefinitions="*,Auto">

                <ScrollView Grid.Row="0" Orientation="Vertical" VerticalScrollBarVisibility="Always">
                    <VerticalStackLayout Spacing="4" Padding="6,8">
                        <!-- Sidebar toggles stacked vertically together -->
                        <Button Text="🧩"
                                Style="{StaticResource IconBtn}"
                                TextColor="#58A6FF"
                                Command="{Binding ToggleSidebarCommand}"
                                ToolTipProperties.Text="Toggle Component Sidebar"/>
                        <Button Text="{Binding LiveMeasurementEyeText}"
                            Style="{StaticResource IconBtn}"
                            TextColor="#56D364"
                            Command="{Binding ToggleLiveMeasurementsCommand}"
                            ToolTipProperties.Text="Toggle voltage and current overlays on all non-wire components"/>
                        <Button Text="📈"
                            Style="{StaticResource IconBtn}"
                            TextColor="#79C0FF"
                            Command="{Binding ToggleSelectedWaveformCommand}"
                            IsEnabled="{Binding HasSelection}"
                            ToolTipProperties.Text="Plot the selected component or wire terminals"/>
                            <Button Text="🧩+"
                                Style="{StaticResource IconBtn}"
                                TextColor="#D2A8FF"
                                Command="{Binding OpenCreateCircuitComponentCommand}"
                                IsEnabled="{Binding HasSelectedComponent}"
                                ToolTipProperties.Text="Package the selected connected circuit as a reusable component"/>
                        <Button Text="📄"
                                Style="{StaticResource IconBtn}"
                                TextColor="#E3B341"
                                Command="{Binding ToggleDescriptionSidebarCommand}"
                                ToolTipProperties.Text="Toggle Description &amp; Properties Sidebar"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Undo / Redo -->
                        <Button Text="↩" Style="{StaticResource IconBtn}"
                                Command="{Binding UndoCommand}"
                                IsEnabled="{Binding CanUndo}"
                                ToolTipProperties.Text="Undo"/>
                        <Button Text="↪" Style="{StaticResource IconBtn}"
                                Command="{Binding RedoCommand}"
                                IsEnabled="{Binding CanRedo}"
                                ToolTipProperties.Text="Redo"/>

                        <!-- Rotate / Copy / Delete selected component -->
                        <Button Text="⟳" Style="{StaticResource IconBtn}"
                                TextColor="#D2A8FF"
                                Command="{Binding RotateSelectedComponentCommand}"
                            IsEnabled="{Binding HasSelection}"
                                ToolTipProperties.Text="Rotate Selected 90°"/>
                        <Button Text="📋" Style="{StaticResource IconBtn}"
                                TextColor="#79C0FF"
                                Command="{Binding CopySelectedComponentCommand}"
                                IsEnabled="{Binding HasSelectedComponent}"
                                ToolTipProperties.Text="Copy Selected Component"/>
                        <Button Text="🗑" Style="{StaticResource IconBtn}"
                                TextColor="#F85149"
                                Command="{Binding DeleteSelectedComponentCommand}"
                            IsEnabled="{Binding HasSelection}"
                                ToolTipProperties.Text="Delete Selected Component"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- Selection / drawing tools -->
                        <Button Text="↖" Style="{StaticResource IconBtn}" CommandParameter="Select"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Select">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="Select">
                                    <Setter Property="BackgroundColor" Value="#1C3060"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="⌁" Style="{StaticResource IconBtn}" CommandParameter="Wire"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Wire">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="Wire">
                                    <Setter Property="BackgroundColor" Value="#1C3060"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="✋" Style="{StaticResource IconBtn}" CommandParameter="Pan"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Pan viewport">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="Pan">
                                    <Setter Property="BackgroundColor" Value="#1C3060"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="✥" Style="{StaticResource IconBtn}" CommandParameter="Move"
                                Command="{Binding SelectToolCommand}" IsEnabled="{Binding HasSelectedComponent}"
                                ToolTipProperties.Text="Move selected component">
                            <Button.Triggers>
                                <DataTrigger TargetType="Button" Binding="{Binding ActiveTool}" Value="Move">
                                    <Setter Property="BackgroundColor" Value="#1C3060"/>
                                </DataTrigger>
                            </Button.Triggers>
                        </Button>
                        <Button Text="✂" Style="{StaticResource IconBtn}" CommandParameter="Cut"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Cut wire"/>
                        <Button Text="⊕" Style="{StaticResource IconBtn}" CommandParameter="Label"
                                Command="{Binding SelectToolCommand}" ToolTipProperties.Text="Net label"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>

                        <!-- View controls -->
                        <Button Text="+" Style="{StaticResource IconBtn}"
                                Command="{Binding ZoomInCommand}" ToolTipProperties.Text="Zoom in"/>
                        <Button Text="−" Style="{StaticResource IconBtn}"
                                Command="{Binding ZoomOutCommand}" ToolTipProperties.Text="Zoom out"/>
                        <BoxView HeightRequest="1" Color="#30363D" Margin="4,4"/>
                        <!-- Help button is in the top-right toolbar; removed here to avoid duplication (§2.D) -->
                    </VerticalStackLayout>
                </ScrollView>

                <HorizontalStackLayout Grid.Row="1" HorizontalOptions="Center" Margin="0,6,0,10" Spacing="2">
                    <Button Text="⌖"
                            Style="{StaticResource IconBtn}"
                            TextColor="#56D364"
                            WidthRequest="40"
                            HeightRequest="40"
                            Command="{Binding RecenterViewportCommand}"
                            ToolTipProperties.Text="Recenter on the mean position of all schematic components"/>
                    <Button Text="⛶"
                            Style="{StaticResource IconBtn}"
                            TextColor="#58A6FF"
                            WidthRequest="40"
                            HeightRequest="40"
                            Command="{Binding FitToScreenCommand}"
                            ToolTipProperties.Text="Fit all components to the screen"/>
                </HorizontalStackLayout>

                <!-- Right border -->
                <BoxView Grid.Row="0" Grid.RowSpan="2"
                         WidthRequest="1" BackgroundColor="#30363D"
                         HorizontalOptions="End"/>
            </Grid>
</ContentView>
