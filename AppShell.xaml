<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="EEE.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:EEE"
    Title="EE Engine"
    Shell.NavBarIsVisible="False"
    BackgroundColor="#161B22">

    <ShellContent
        x:Name="WorkspaceShellContent"
        Route="workspace"/>

    <ShellContent
        x:Name="SettingsShellContent"
        Route="settings"/>

    <ShellContent
        ContentTemplate="{DataTemplate local:HelpPage}"
        Route="help"/>

    <ShellContent
        ContentTemplate="{DataTemplate local:ExamplesPage}"
        Route="examples"/>
</Shell>
